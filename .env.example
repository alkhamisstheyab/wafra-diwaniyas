# ---------------------------------------------------------------
# Cloudflare Pages → Settings → Variables and Secrets
# Set them separately for "Production" and "Preview".
# Never commit real values.
# ---------------------------------------------------------------

# Apps Script web app URL (Deploy > Manage deployments > Web app URL), ends with /exec
# Preview must point to the TEST spreadsheet, Production to the real one.
GAS_URL=

# Shared secret between Cloudflare and Apps Script (type: Secret / Encrypt).
# At least 32 random characters. Same value in Apps Script > Project Settings > Script properties > GATEWAY_SECRET.
# Use a different value for Preview and Production.
GATEWAY_SECRET=

# Optional: bind a KV namespace named PUBLIC_KV to keep a "last good" public copy for outages.

# ---------------------------------------------------------------
# Apps Script > Project Settings > Script properties (server only)
# ---------------------------------------------------------------
# GATEWAY_SECRET   same value as above
# PIN              initial admin PIN (10+ characters). Replaced by PIN_HASH/PIN_SALT after the first change from the admin panel.
# GEMINI_KEY       Google AI Studio key for reading announcement images
# LEGACY_PIN       set to "off" after the new site is live, to close the old direct-PIN path
